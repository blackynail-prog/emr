          </div>
        </main>
        <PortalFooter />
      </Layout>
    );
  }
  
  return c.html(
    <Layout title={`${notice.title} - 산학처 공지사항`}>
      <PortalHeader currentPath="/notices" />
      
      <main class="max-w-4xl mx-auto px-4 py-8">
        <NoticeDetail notice={notice} />
        
        {/* 안내 문구 */}
        <div class="mt-8 p-4 bg-gray-50 border border-gray-200 rounded-lg">
          <p class="text-sm text-gray-600 leading-relaxed">
            <i class="fas fa-info-circle text-blue-600 mr-2"></i>
            본 페이지는 LMS 게시 전 임시 안내 페이지입니다. 최종 공지 사항은 반드시 LMS를 확인하세요.
          </p>
        </div>
      </main>
      
      <PortalFooter />
    </Layout>
  );
});

// 병원별 OT 페이지
app.get('/hospital/:slug', async (c) => {
  const slug = c.req.param('slug');
  const hospital = hospitalData[slug];
  
  if (!hospital) {
    return c.html(
      <Layout title="페이지를 찾을 수 없습니다">
        <PortalHeader currentPath="/" />
        <main class="max-w-5xl mx-auto px-4 py-8 sm:py-12">
          <div class="bg-red-50 border-l-4 border-red-400 p-6 rounded-lg text-center">
            <i class="fas fa-exclamation-circle text-red-600 text-5xl mb-4"></i>
            <h2 class="text-2xl font-bold text-gray-800 mb-2">페이지를 찾을 수 없습니다</h2>
            <p class="text-gray-700 mb-6">요청하신 병원 정보가 존재하지 않습니다.</p>
            <a href="/" class="inline-block px-6 py-3 bg-blue-600 text-white rounded-lg hover:bg-blue-700 transition font-semibold">
              <i class="fas fa-home mr-2"></i>홈으로 돌아가기
            </a>
          </div>
        </main>
        <PortalFooter />
      </Layout>
    );
  }
  
  // 인증 체크
  const authResult = await authMiddleware(c, slug);
  if (authResult) return authResult;
  
  // 현재 로그인한 병원 정보 가져오기
  const currentHospital = await getCurrentHospital(c);
  
  return c.html(
    <Layout title={`${hospital.name} - 실습 오리엔테이션 안내`}>
      {/* 병원 전용 고정 헤더 */}
      <HospitalBadge 
        hospitalName={currentHospital?.hospitalName || hospital.name}
        hospitalSlug={slug}
      />
      
      <main class="max-w-4xl mx-auto px-4 py-8">
        {/* 산학처 공지사항 배너 */}
        <NoticeBanner />
        
        {/* 핵심 요약 카드 */}
        <SummaryCard hospital={hospital} />
        
        {/* 아코디언 섹션들 */}
        <div class="space-y-0">
          {/* 체크리스트 - 기본 열림 */}
          <AccordionSection
            id="checklist"
            title="실습 전 체크리스트"
            icon="fas fa-check-square"
            items={hospital.sections.checklist}
            defaultOpen={true}
            emptyMessage="체크리스트를 준비 중입니다."
          />
          
          {/* 복장·준비물 - 기본 열림 */}
          <AccordionSection
            id="dressCode"
            title="복장 및 준비물 안내"
            icon="fas fa-user-tie"
            items={hospital.sections.dressCode}
            defaultOpen={true}
            emptyMessage="복장 및 준비물 정보를 준비 중입니다."
          />
          
          {/* 출근/출입/동선 안내 */}
          <AccordionSection
            id="flow"
            title="출근 및 출입 절차 안내"
            icon="fas fa-map-signs"
            items={hospital.sections.flow}
            defaultOpen={false}
            emptyMessage="동선 안내를 준비 중입니다."
          />
          
          {/* 커뮤니케이션 */}
          <AccordionSection
            id="comm"
            title="실습 중 유의사항"
            icon="fas fa-comments"
            items={hospital.sections.comm}
            defaultOpen={false}
            emptyMessage="커뮤니케이션 가이드를 준비 중입니다."
          />
          
          {/* 안전/감염관리 */}
          <AccordionSection
            id="safety"
            title="감염관리 및 안전 수칙"
            icon="fas fa-shield-alt"
            items={hospital.sections.safety}
            defaultOpen={false}
            emptyMessage="안전 및 감염관리 정보를 준비 중입니다."
          />
          
          {/* 과제/평가 */}
          <AccordionSection
            id="assignment"
            title="과제 및 평가 관련 안내"
            icon="fas fa-clipboard-check"
            items={hospital.sections.assignment}
            defaultOpen={false}
            emptyMessage="과제 및 평가 안내를 준비 중입니다."
          />
          
          {/* FAQ */}
          <FAQSection
            id="faq"
            faqs={hospital.sections.faq}
            defaultOpen={false}
          />
          
          {/* 다운로드 */}
          <DownloadSection
            id="downloads"
            downloads={hospital.sections.downloads}
            defaultOpen={false}
          />
          
          {/* 보호된 자산 뷰어 (인증 필요) */}
          {slug === 'uijeongbu' && (
            <div class="mb-6">
              <ProtectedAssetViewer
                hospitalId="UJB"
                pdfPath="2026-1-masterplan-ot.pdf"
                imagePath="uijeongbu-locker-guide.jpg"
                videoPath="uijeongbu-locker-video.mp4"
              />
            </div>
          )}
          {slug === 'ilsan' && (
            <div class="mb-6">
              <ProtectedAssetViewer
                hospitalId="NHIS"
                pdfPath="test.txt"
              />
            </div>
          )}
          {slug === 'gangdong' && (
            <div class="mb-6">
              <ProtectedAssetViewer
                hospitalId="KHU"
                pdfPath="test.txt"
              />
            </div>
          )}
        </div>
        
        {/* CTA 버튼들 */}
        <CTAButtons hospitalSlug={slug} />
      </main>
      
      <PortalFooter />
      <HospitalPageScripts />
      <AddToHomeScreenPrompt />
    </Layout>
  );
});

// 404 페이지
app.notFound((c) => {
  return c.html(
    <Layout title="페이지를 찾을 수 없습니다">
      <PortalHeader currentPath="/" />
      <main class="max-w-5xl mx-auto px-4 py-8 sm:py-12">
        <div class="bg-gray-50 border border-gray-200 p-8 rounded-lg text-center">
          <i class="fas fa-search text-gray-400 text-6xl mb-4"></i>
          <h2 class="text-3xl font-bold text-gray-800 mb-2">404 - 페이지를 찾을 수 없습니다</h2>
          <p class="text-gray-600 mb-6">요청하신 페이지가 존재하지 않습니다.</p>
          <a href="/" class="inline-block px-6 py-3 bg-blue-600 text-white rounded-lg hover:bg-blue-700 transition font-semibold">
            <i class="fas fa-home mr-2"></i>홈으로 돌아가기
          </a>
        </div>
      </main>
      <PortalFooter />
    </Layout>
  );
});

export default app;
