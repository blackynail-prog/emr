    'uijeongbu': '/images/uijeongbu.png',
    'gangdong': '/images/gangdong.png',
    'ilsan': '/images/ilsan.png'
  };
  
  return c.html(
    <HospitalLoginPage
      hospitalSlug={slug}
      hospitalName={hospital.name}
      hospitalLogo={hospitalLogos[slug] || '/images/snjc-logo.png'}
