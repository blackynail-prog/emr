// 병원별 로그인 페이지 (이전 방식, 호환성 유지)
app.get('/hospital/:slug/login', (c) => {
  const slug = c.req.param('slug');
  const hospital = hospitalData[slug];
  
  if (!hospital) {
    return c.redirect('/login');
  }
  
  const hospitalLogos: Record<string, string> = {
    'uijeongbu': '/images/uijeongbu.png',
    'gangdong': '/images/gangdong.png',
    'ilsan': '/images/ilsan.png'
  };
  
  return c.html(
    <HospitalLoginPage
      hospitalSlug={slug}
      hospitalName={hospital.name}
      hospitalLogo={hospitalLogos[slug] || '/images/snjc-logo.png'}
    />
  );
});

// 병원별 로그인 페이지 - 에러 처리 (이전 방식)
app.get('/hospital/:slug/login/error', (c) => {
  const slug = c.req.param('slug');
  const hospital = hospitalData[slug];
  
