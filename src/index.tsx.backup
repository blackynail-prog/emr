// 정적 이미지를 외부 URL로 리다이렉트 (로컬 개발용)
// 프로덕션에서는 Cloudflare Pages가 자동으로 제공합니다
app.get('/images/:filename', async (c) => {
  const filename = c.req.param('filename');
  // 이미지를 직접 외부 URL로 제공
  const imageUrls: Record<string, string> = {
    'uijeongbu.png': 'https://sspark.genspark.ai/cfimages?u1=zhMmgLKyRzQaBa2vF3JBiABLeyOsh5ViPhPddkqTEZ27gLHPnZ5pdKi6rLOqsgSArK3amCCYTY0PI0wtE14AUY5A%2F99%2FopYuEpVgStQ%3D&u2=7VspsWeqI26OIjNM&width=2560',
    'gangdong.png': 'https://sspark.genspark.ai/cfimages?u1=pkS3y1YXtw8yPE01wFVFaCfpljpZYbOUd%2Ba21oKhGfyF%2FIS4ko%2BCY9JiGMzCP9m2xtrSSKoTiOKpgMThamX1Brux20BrNDaG1DVF%2BA0v0WyRVwz308zW&u2=q0xJillZ%2BgEgxqGg&width=2560',
    'ilsan.png': 'https://sspark.genspark.ai/cfimages?u1=5J9BKD0cRYdqwi%2BTlpvi5lDGPVqcxdmlArCtYx4qkGm0B63DVkuSfpUFReyCoEDf8e5tsPdWHqX%2BYWlfG8wMkD%2FDENR97%2BC8bUfmzbeVUIMveg4qG0bvy48i&u2=24tnRnNppQc3PxKf&width=2560',
    'snjc-logo.png': 'https://www.genspark.ai/api/files/s/9M7M7Jgi'
  };
  
  if (imageUrls[filename]) {
    // 캐시 헤더와 함께 리다이렉트 (브라우저 캐싱 활성화)
    return c.redirect(imageUrls[filename], 302);
