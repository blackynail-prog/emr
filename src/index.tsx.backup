// 홈페이지 - 병원 선택 페이지로 리다이렉트
app.get('/', async (c) => {
  const hospital = await getCurrentHospital(c);
  
  // 로그인된 경우 해당 병원 페이지로 리다이렉트
  if (hospital) {
    return c.redirect(`/hospital/${hospital.hospitalSlug}`);
  }
  
  // 로그인하지 않은 경우 병원 선택 페이지로
  return c.redirect('/login');
});

