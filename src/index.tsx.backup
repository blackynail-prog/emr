type Bindings = {
  AUTH_KV: KVNamespace;
  JWT_SECRET: string;
  PEPPER: string;
  ALLOWED_ORIGIN?: string;
  ASSETS?: Fetcher;
}

const app = new Hono<{ Bindings: Bindings }>();

// ===== CORS 및 보안 헤더 =====
app.use('/api/*', async (c, next) => {
  const origin = c.env.ALLOWED_ORIGIN || 'https://3000-ibe99ya25l3zel576nxlh-82b888ba.sandbox.novita.ai';
  
  // CORS 헤더
  c.header('Access-Control-Allow-Origin', origin);
  c.header('Access-Control-Allow-Methods', 'GET, POST, OPTIONS');
  c.header('Access-Control-Allow-Headers', 'Content-Type, Authorization');
  c.header('Access-Control-Max-Age', '86400');
  
  // 보안 헤더
  c.header('X-Content-Type-Options', 'nosniff');
  c.header('X-Frame-Options', 'DENY');
  c.header('X-XSS-Protection', '1; mode=block');
  c.header('Referrer-Policy', 'strict-origin-when-cross-origin');
  c.header('Content-Security-Policy', "default-src 'self'; script-src 'self' 'unsafe-inline' https://cdn.tailwindcss.com https://cdn.jsdelivr.net; style-src 'self' 'unsafe-inline' https://cdn.jsdelivr.net; img-src 'self' data: https:; font-src 'self' https://cdn.jsdelivr.net;");
  
  // OPTIONS 요청 처리
  if (c.req.method === 'OPTIONS') {
    return c.text('', 204);
  }
  
  await next();
});

// ===== Worker API 엔드포인트 =====

// POST /api/auth/verify-code - 접속코드 검증 및 토큰 발급
app.post('/api/auth/verify-code', async (c) => {
  try {
    // 레이트 리밋 체크
    const rateLimitResult = await checkRateLimit(c.req.raw, c.env);
    if (!rateLimitResult.allowed) {
      return c.json({
        error: 'RATE_LIMIT_EXCEEDED',
        message: '너무 많은 시도가 있었습니다. 잠시 후 다시 시도해주세요.',
        retry_after: rateLimitResult.retry_after
      }, 429);
    }
    
    // 요청 데이터 파싱
    const body = await c.req.json();
    const code = body.code as string;
    
    // 코드 형식 검증
    if (!code || !/^SWCN_[A-Z0-9]+$/.test(code)) {
      return c.json({
        error: 'INVALID_FORMAT',
        message: '올바른 접속코드 형식이 아닙니다.'
      }, 400);
    }
    
    // 접속코드 검증
    const result = await verifyAccessCode(code, c.env);
    if (!result) {
      return c.json({
        error: 'INVALID_CODE',
        message: '유효하지 않은 접속코드입니다.'
      }, 401);
    }
    
    // JWT 토큰 생성
    const jwt = await generateJWT(result, c.env);
    
    return c.json({
      success: true,
      token: jwt.token,
      hospital_id: result.hospital_id,
      hospital_name: result.hospital_name,
      expires_at: jwt.expires_at
    });
    
  } catch (err) {
    console.error('verify-code error:', err);
    return c.json({
      error: 'INTERNAL_ERROR',
      message: '서버 오류가 발생했습니다.'
    }, 500);
  }
});

// GET /api/auth/me - 현재 토큰 정보 조회
app.get('/api/auth/me', async (c) => {
  try {
    // Authorization 헤더에서 토큰 추출
    const authHeader = c.req.header('Authorization');
    if (!authHeader || !authHeader.startsWith('Bearer ')) {
      return c.json({
        error: 'MISSING_TOKEN',
        message: '인증 토큰이 필요합니다.'
      }, 401);
    }
    
    const token = authHeader.substring(7);
    
    // 토큰 검증
    const payload = await verifyJWT(token, c.env);
    if (!payload) {
      return c.json({
        error: 'TOKEN_EXPIRED',
        message: '토큰이 만료되었거나 유효하지 않습니다.'
      }, 401);
    }
    
    return c.json({
      hospital_id: payload.hospital_id,
      hospital_name: payload.hospital_name,
      exp: payload.exp
    });
    
  } catch (err) {
    console.error('auth/me error:', err);
    return c.json({
      error: 'INTERNAL_ERROR',
      message: '서버 오류가 발생했습니다.'
    }, 500);
  }
});

// GET /protected/:hospitalId/:filename - 보호된 자산 다운로드
app.get('/protected/:hospitalId/:filename', async (c) => {
  try {
    // Authorization 헤더에서 토큰 추출
    const authHeader = c.req.header('Authorization');
    if (!authHeader || !authHeader.startsWith('Bearer ')) {
      return c.json({
        error: 'MISSING_TOKEN',
        message: '인증이 필요합니다.'
      }, 401);
    }
    
    const token = authHeader.substring(7);
    
    // 토큰 검증
    const payload = await verifyJWT(token, c.env);
    if (!payload) {
      return c.json({
        error: 'TOKEN_EXPIRED',
        message: '토큰이 만료되었거나 유효하지 않습니다.'
      }, 401);
    }
    
    // 경로 파라미터
    const hospitalId = c.req.param('hospitalId');
    const filename = c.req.param('filename');
    
    // Hospital ID 매핑 (토큰의 slug → 경로의 ID)
    const hospitalIdMap: Record<string, string> = {
      'uijeongbu': 'UJB',
      'ilsan': 'NHIS',
      'gangdong': 'KHU'
    };
    
    const expectedHospitalId = hospitalIdMap[payload.hospital_id];
    
    // 권한 검증: 자신의 병원 파일만 접근 가능
    if (expectedHospitalId !== hospitalId) {
      return c.json({
        error: 'ACCESS_DENIED',
        message: '이 파일에 대한 접근 권한이 없습니다.'
      }, 403);
    }
    
    // Cloudflare Pages ASSETS binding 사용
    // 파일 경로: /protected/{hospitalId}/{filename}
    const assetPath = `/protected/${hospitalId}/${filename}`;
    
    try {
      let assetResponse;
      
      // ASSETS binding이 있으면 사용, 없으면 직접 fetch
      if (c.env.ASSETS) {
        const assetRequest = new Request(new URL(assetPath, c.req.url).toString());
        assetResponse = await c.env.ASSETS.fetch(assetRequest);
      } else {
        // 로컬 개발: 직접 fetch
        assetResponse = await fetch(new URL(assetPath, c.req.url).toString());
      }
      
      if (!assetResponse.ok) {
        return c.json({
          error: 'ASSET_NOT_FOUND',
          message: '파일을 찾을 수 없습니다.'
        }, 404);
      }

      // 파일 응답 with headers
      return new Response(assetResponse.body, {
        status: 200,
        headers: {
          'Content-Type': assetResponse.headers.get('Content-Type') || 'application/octet-stream',
          'Content-Disposition': `inline; filename="${filename}"`,
          'Cache-Control': 'private, max-age=3600',
          'Access-Control-Allow-Origin': c.env.ALLOWED_ORIGIN || '*'
        }
      });
      
    } catch (fetchError) {
      console.error('File fetch error:', fetchError);
      return c.json({
        error: 'ASSET_NOT_FOUND',
        message: '파일을 찾을 수 없습니다.'
      }, 404);
    }
    
  } catch (err) {
    console.error('protected asset error:', err);
    return c.json({
      error: 'INTERNAL_ERROR',
      message: '서버 오류가 발생했습니다.'
    }, 500);
  }
});

// GET /api/assets/:path - 보호된 자산 다운로드 (레거시)
app.get('/api/assets/:path', async (c) => {
  try {
    // Authorization 헤더에서 토큰 추출
    const authHeader = c.req.header('Authorization');
    if (!authHeader || !authHeader.startsWith('Bearer ')) {
      return c.json({
        error: 'MISSING_TOKEN',
        message: '인증이 필요합니다.'
      }, 401);
    }
    
    const token = authHeader.substring(7);
    
    // 토큰 검증
    const payload = await verifyJWT(token, c.env);
    if (!payload) {
      return c.json({
        error: 'TOKEN_EXPIRED',
        message: '토큰이 만료되었거나 유효하지 않습니다.'
      }, 401);
    }
    
    // 파일 경로
    const path = c.req.param('path');
    
    // 권한 검증: hospital_id- 또는 common- 으로 시작해야 함
    const hospitalPrefix = `${payload.hospital_id}-`;
    if (!path.startsWith(hospitalPrefix) && !path.startsWith('common-')) {
      return c.json({
        error: 'ACCESS_DENIED',
        message: '접근 권한이 없습니다.'
      }, 403);
    }
    
    // TODO: 실제 파일 읽기 로직 (R2 또는 로컬 파일)
    // 현재는 404 반환
    return c.json({
      error: 'ASSET_NOT_FOUND',
      message: '파일을 찾을 수 없습니다.'
    }, 404);
    
  } catch (err) {
    console.error('assets error:', err);
    return c.json({
      error: 'INTERNAL_ERROR',
      message: '서버 오류가 발생했습니다.'
    }, 500);
  }
});

// POST /api/admin/seed-kv - KV 초기화 (로컬 개발 전용)
app.post('/api/admin/seed-kv', async (c) => {
  // 로컬 개발 환경에서만 허용
  const isLocal = c.env.ENVIRONMENT === 'development';
  if (!isLocal) {
    return c.json({
      error: 'FORBIDDEN',
      message: '프로덕션에서는 사용할 수 없습니다.'
    }, 403);
  }
  
  try {
    // KV 데이터 시딩 (PEPPER: dev-random-pepper-string-for-hashing-salt-2026 기준)
    const codes = [
      { code: 'SWCN_CMC2026', hash: '592bc6ea6564b72a47cf698900c0da00b2f4b9e2c81acc089c79693ec6eb168b', hospital_id: 'uijeongbu', hospital_name: '가톨릭대학교 의정부성모병원' },
      { code: 'SWCN_NHIS2026', hash: '085db33be8f8516e95db897aa257aae933a5228ed11c51e2ccbe7e180bd243e4', hospital_id: 'ilsan', hospital_name: '국민건강보험공단 일산병원' },
      { code: 'SWCN_KHUH2026', hash: '30e8ccb04e5a862407dbde13ada1e156ed904b0b0d9ca73b9b923bc3069a9f57', hospital_id: 'gangdong', hospital_name: '강동경희대병원' },
    ];
    
    const results = [];
    for (const item of codes) {
      const value = JSON.stringify({
        hospital_id: item.hospital_id,
        hospital_name: item.hospital_name
      });
      
      await c.env.AUTH_KV.put(item.hash, value);
      results.push(`✓ ${item.code} → ${item.hospital_name} (${item.hash.substring(0, 16)}...)`);
    }
    
    return c.json({
      success: true,
      message: 'KV 데이터 시딩 완료',
      results
    });
    
  } catch (err) {
    console.error('seed-kv error:', err);
    return c.json({
      error: 'INTERNAL_ERROR',
      message: '시딩 중 오류가 발생했습니다.'
    }, 500);
  }
});

// GET /api/admin/check-kv/:code - KV 데이터 확인 (로컬 개발 전용)
app.get('/api/admin/check-kv/:code', async (c) => {
  const isLocal = c.env.ENVIRONMENT === 'development';
  if (!isLocal) {
    return c.json({ error: 'FORBIDDEN' }, 403);
  }
  
  try {
    const code = c.req.param('code');
    
    // 해시 계산
    const encoder = new TextEncoder();
    const data = encoder.encode(code + c.env.PEPPER);
    const hashBuffer = await crypto.subtle.digest('SHA-256', data);
    const hashArray = Array.from(new Uint8Array(hashBuffer));
    const hash = hashArray.map(b => b.toString(16).padStart(2, '0')).join('');
    
    // KV에서 조회
    const value = await c.env.AUTH_KV.get(hash, 'json');
    
    return c.json({
      code,
      hash,
      value,
      found: !!value
    });
    
  } catch (err) {
    console.error('check-kv error:', err);
    return c.json({ error: 'INTERNAL_ERROR' }, 500);
  }
});

