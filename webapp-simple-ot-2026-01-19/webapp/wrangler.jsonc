{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "webapp",
  "compatibility_date": "2026-01-18",
  "pages_build_output_dir": "./dist",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "kv_namespaces": [
    {
      "binding": "AUTH_KV",
      "id": "local-kv-for-development"
    }
  ],
  "vars": {
    "ENVIRONMENT": "development"
  }
}